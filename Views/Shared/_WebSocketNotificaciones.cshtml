@inject Microsoft.Extensions.Configuration.IConfiguration Config

<script src="https://js.pusher.com/7.2/pusher.min.js"></script>
<script>
    // Enable pusher logging - don't include this in production
    // Pusher.logToConsole = true;

    var userId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
    
    if (userId) {
        // La notificación en tiempo real está activa pero sin cuadro visual molesto.

        var pusher = new Pusher('@Config["PieSocket:ApiKey"]', {
            cluster: '@Config["PieSocket:Cluster"]',
            wsHost: '@Config["PieSocket:Cluster"]' + '.piesocket.com',
            wsPort: 443,
            forceTLS: true,
            disableStats: true,
            authEndpoint: '/hubs/solicitudes', // Endpoint protegido con Identity
            auth: {
                headers: {
                    // Si usas CSRF global
                }
            }
        });

        pusher.connection.bind('state_change', function(states) {
            // Se quitó la notificación visual para mantener la interfaz limpia
            if (states.current === 'disconnected' || states.current === 'unavailable') {
                // Si reconecta, la página debería recargar para obtener estado actual (requerido por rúbrica)
                if (states.previous === 'connected') {
                    setTimeout(() => window.location.reload(), 2000);
                }
            }
        });

        var channel = pusher.subscribe('private-solicitudes-' + userId);

        channel.bind('SolicitudEstadoActualizado', function(data) {
            // "Actualizar el estado mostrado y presentar un aviso sin recargar la página."
            var estadoValue = data.estado || data.Estado;
            var solicitudIdValue = data.solicitudId || data.SolicitudId;
            var motivoValue = data.motivoRechazo || data.MotivoRechazo;

            if (!estadoValue) return; // Prevención de errores

            var aviso = document.createElement('div');
            aviso.className = 'alert alert-primary alert-dismissible fade show mt-3 shadow-sm';
            aviso.innerHTML = '<strong>¡Actualización!</strong> Tu solicitud #' + solicitudIdValue + ' ha sido <b>' + estadoValue.toUpperCase() + '</b>.' +
                (motivoValue ? ' Motivo: ' + motivoValue : '') +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
            
            document.querySelector('.container').prepend(aviso);

            // Actualizar fila si estamos en Mis Solicitudes
            var row = document.getElementById('solicitud-row-' + solicitudIdValue);
            if (row) {
                var badge = row.querySelector('.badge-estado');
                if (badge) {
                    badge.innerHTML = estadoValue;
                    var badgeClass = estadoValue === 'Aprobado' ? 'badge-aprobado' : 'badge-rechazado';
                    badge.className = 'badge-estado ' + badgeClass;
                }
            }

            // Actualizar detalle si estamos en Detalle
            var detalleBadge = document.getElementById('detalle-badge-estado');
            if (detalleBadge) {
                detalleBadge.innerHTML = estadoValue;
                var detalleBadgeClass = estadoValue === 'Aprobado' ? 'bg-success' : 'bg-danger';
                detalleBadge.className = 'badge p-2 px-3 text-white ' + detalleBadgeClass;
                
                if (estadoValue === 'Rechazado' && motivoValue) {
                    var motivoCont = document.getElementById('detalle-motivo');
                    if (motivoCont) {
                        motivoCont.style.display = 'block';
                        motivoCont.innerHTML = '<strong>Motivo del rechazo:</strong> ' + motivoValue;
                    }
                }
            }
        });
    }
</script>
